<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #f5f5f5;" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="group_3.controller.LoginController">
    
    <padding>
        <Insets bottom="50" left="50" right="50" top="50"/>
    </padding>
    
    <!-- Login Card -->
    <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" 
          prefWidth="400" maxWidth="400">
        <padding>
            <Insets bottom="40" left="40" right="40" top="40"/>
        </padding>
        
        <!-- Title -->
        <Label text="Event Management System" style="-fx-text-fill: #2c3e50;">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>
        
        <Label text="Sign in to your account" style="-fx-text-fill: #7f8c8d;">
            <font>
                <Font size="14"/>
            </font>
        </Label>
        
        <!-- Error Message -->
        <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c;" visible="false" managed="false">
            <font>
                <Font size="12"/>
            </font>
        </Label>
        
        <!-- Username Field -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Username" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
            <TextField fx:id="usernameField" promptText="Enter your username" 
                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 10;"
                       prefWidth="320"/>
        </VBox>
        
        <!-- Password Field -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Password" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField" promptText="Enter your password"
                           style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 10;"
                           prefWidth="320" onAction="#handleLogin"/>
        </VBox>
        
        <!-- Login Button -->
        <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                prefWidth="320" prefHeight="40">
            <font>
                <Font size="14"/>
            </font>
        </Button>
        
        <!-- Register Link -->
        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?" style="-fx-text-fill: #7f8c8d;"/>
            <Hyperlink fx:id="registerLink" text="Register here" onAction="#handleRegisterLink"
                       style="-fx-text-fill: #3498db;"/>
        </HBox>
    </VBox>
</VBox>
