<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15" style="-fx-background-color: #f5f5f5;" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="group_3.controller.RegistrationController">
    
    <padding>
        <Insets bottom="30" left="50" right="50" top="30"/>
    </padding>
    
    <!-- Registration Card -->
    <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" 
          prefWidth="450" maxWidth="450">
        <padding>
            <Insets bottom="30" left="40" right="40" top="30"/>
        </padding>
        
        <!-- Title -->
        <Label text="Create Account" style="-fx-text-fill: #2c3e50;">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>
        
        <Label text="Register for the Event Management System" style="-fx-text-fill: #7f8c8d;">
            <font>
                <Font size="12"/>
            </font>
        </Label>
        
        <!-- Error/Success Message -->
        <Label fx:id="messageLabel" style="-fx-text-fill: #e74c3c;" visible="false" managed="false" wrapText="true">
            <font>
                <Font size="12"/>
            </font>
        </Label>
        
        <!-- Username Field -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="Username *" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <TextField fx:id="usernameField" promptText="Choose a username" 
                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;"
                       prefWidth="370"/>
        </VBox>
        
        <!-- Full Name Field -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="Full Name *" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <TextField fx:id="fullNameField" promptText="Enter your full name" 
                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;"
                       prefWidth="370"/>
        </VBox>
        
        <!-- Password Fields -->
        <HBox spacing="10">
            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="Password *" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12;"/>
                <PasswordField fx:id="passwordField" promptText="Password"
                               style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;"/>
            </VBox>
            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="Confirm Password *" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm"
                               style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;"/>
            </VBox>
        </HBox>
        
        <!-- Date of Birth -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="Date of Birth" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <DatePicker fx:id="dateOfBirthPicker" promptText="Select date"
                        style="-fx-background-radius: 5;" prefWidth="370"/>
        </VBox>
        
        <!-- Contact Information -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="Email / Contact" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <TextField fx:id="contactField" promptText="Enter email or phone number" 
                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;"
                       prefWidth="370"/>
        </VBox>
        
        <!-- Role Selection -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="Register as *" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <ComboBox fx:id="roleComboBox" promptText="Select your role"
                      style="-fx-background-radius: 5;" prefWidth="370"/>
        </VBox>
        
        <!-- Presenter Role (conditional) -->
        <VBox fx:id="presenterRoleBox" spacing="3" alignment="CENTER_LEFT" visible="false" managed="false">
            <Label text="Presenter Specialty" style="-fx-text-fill: #34495e; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <TextField fx:id="presenterRoleField" promptText="e.g., Keynote Speaker, Workshop Leader" 
                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;"
                       prefWidth="370"/>
        </VBox>
        
        <!-- Register Button -->
        <Button fx:id="registerButton" text="Create Account" onAction="#handleRegister"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                prefWidth="370" prefHeight="40">
            <font>
                <Font size="14"/>
            </font>
        </Button>
        
        <!-- Login Link -->
        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?" style="-fx-text-fill: #7f8c8d;"/>
            <Hyperlink fx:id="loginLink" text="Sign in" onAction="#handleLoginLink"
                       style="-fx-text-fill: #3498db;"/>
        </HBox>
    </VBox>
</VBox>
